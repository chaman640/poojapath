###############################################################
#  Pooja Path — Environment Variables
#  Is file ko copy karke ".env" banayein aur values bharein.
#  .env file KABHI GitHub par push mat karna (.gitignore me hai).
###############################################################

# ---------- 1. DATABASE (zaroori) ----------
# Render par PostgreSQL banane ke baad "Internal Database URL" yahan paste karein
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# ---------- 2. SITE ----------
# Aapka final domain (bina slash ke). Local par: http://localhost:3000
NEXT_PUBLIC_SITE_URL="https://poojapath.in"
NEXT_PUBLIC_SITE_NAME="Pooja Path"
# Hindi me site ka naam (Navbar/Footer par dikhega)
NEXT_PUBLIC_SITE_NAME_HI="पूजा पथ"

# Site par dikhne wala contact
NEXT_PUBLIC_SUPPORT_PHONE="+919999999999"
NEXT_PUBLIC_SUPPORT_WHATSAPP="+919999999999"
NEXT_PUBLIC_SUPPORT_EMAIL="support@poojapath.in"

# ---------- 3. ADMIN LOGIN (zaroori) ----------
# Kam se kam 32 characters ka random secret. Banane ke liye:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="yahan-lamba-random-secret-daalein-kam-se-kam-32-characters"

# Pehla admin account (sirf seed script ke liye use hota hai)
ADMIN_EMAIL="admin@poojapath.in"
ADMIN_PASSWORD="BadalDeinYeAbhi@2026"

# ---------- 4. PAYMENT GATEWAY ----------
# "paytm" | "razorpay" | khaali (khaali = jo bhi keys mile wahi use hoga)
# Kisi ki bhi keys na ho to site "Demo Mode" me chalegi:
# booking ban jayegi lekin paisa nahi katega.
PAYMENT_PROVIDER="paytm"

# --- Paytm --- (Dashboard > Developer Settings > API Keys)
PAYTM_MID=""
PAYTM_MERCHANT_KEY=""
# Production me "DEFAULT", staging/test me "WEBSTAGING"
PAYTM_WEBSITE="DEFAULT"
# "test" = staging server, "production" = live
PAYTM_ENV="test"
# Paytm dashboard me callback URL ye rakhein:
#   https://aapka-domain.com/api/payment/paytm/callback

# --- Razorpay (agar baad me switch karna ho) ---
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Webhook URL: https://aapka-domain.com/api/payment/webhook
RAZORPAY_WEBHOOK_SECRET=""

# ---------- 5. WHATSAPP UPDATES (baad me bhar sakte hain) ----------
# Provider: "aisensy" | "interakt" | "none"
WHATSAPP_PROVIDER="none"

# AiSensy: Dashboard > Manage > API Key
AISENSY_API_KEY=""
AISENSY_CAMPAIGN_BOOKING="booking_confirmed"
AISENSY_CAMPAIGN_STATUS="booking_status_update"

# Interakt: Settings > Developer Settings > Secret Key (Base64)
INTERAKT_API_KEY=""
INTERAKT_TEMPLATE_BOOKING="booking_confirmed"
INTERAKT_TEMPLATE_STATUS="booking_status_update"

# ---------- 6. CLOUDINARY (photo upload ke liye) ----------
# cloudinary.com par free account banayein → Dashboard me ye teeno milenge
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------- 7. BUSINESS DETAILS (payment gateway KYC ke liye) ----------
# Ye site par Contact aur Legal pages par dikhte hain — gateway approval
# ke liye asli naam aur pura pata daalna zaroori hai.
NEXT_PUBLIC_BUSINESS_NAME="Pooja Path"
NEXT_PUBLIC_BUSINESS_ADDRESS="Dukan/Makan no., Gali, Sheher, Rajya - Pincode"
NEXT_PUBLIC_GSTIN=""
