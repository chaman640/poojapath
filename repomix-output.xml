/** DB me har field ke En/Hi version hain — sahi wala chunta hai */
export function pick(lang: Lang, en: string, hi: string): string {
  const value = lang === "hi" ? hi : en;
  return value?.trim() ? value : en || hi;
}

export function pickList(lang: Lang, en: string[], hi: string[]): string[] {
  const value = lang === "hi" ? hi : en;
  return value?.length ? value : en?.length ? en : hi || [];
}

