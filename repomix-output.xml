/*  Relations                                                          */
/* ------------------------------------------------------------------ */

export const pujaRelations = relations(pujas, ({ one, many }) => ({
  category: one(categories, {
    fields: [pujas.categoryId],
    references: [categories.id],
  }),
  temple: one(temples, { fields: [pujas.templeId], references: [temples.id] }),
