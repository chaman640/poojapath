    artKey: formData.get("artKey") ?? "kalash",
    kind: formData.get("kind") ?? "SERVICE",
    isActive: formData.get("isActive") === "on",
    order: Number(formData.get("order") ?? 0),
  });

  if (!parsed.success) return { error: firstError(parsed.error) };
  const d = parsed.data;

  const values = {
